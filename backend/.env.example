# EASIEST: don't edit this by hand. Run   npm run setup   and it creates .env for you.
#
# If you do it by hand, copy this file to ".env" (exactly that name), fill it in and save with Ctrl+S.

PORT=5000

# Atlas > Database > Connect > Drivers. Replace USER and PASSWORD, keep /moodtracker.
# If the password has special characters (@ # / :) use npm run setup instead.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/moodtracker?retryWrites=true&w=majority

# Any long random text (at least 16 characters). Use a different one in production.
JWT_SECRET=change_this_to_a_long_random_string

# Optional. Which websites may call this API (comma separated). Set it when you deploy:
# CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
